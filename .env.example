# ==========================================
# TokenSlim Environment Configuration
# ==========================================

# Bifrost Gateway Configuration (Bifrost Problem Statement #01)
# Default local Bifrost gateway instance endpoint
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=bifrost-local-key
MODEL_NAME=gpt-4o-mini

# Direct / Fallback Provider Keys (used if configuring Bifrost or standalone)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Tavily API Configuration (Stale-Answer Detector)
TAVILY_API_KEY=

# TokenSlim Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Agent Execution & Budget Limits
DEFAULT_TOKEN_BUDGET=15000
MAX_REPAIR_ITERATIONS=4
TASK_TIMEOUT_SECONDS=120

# Demo & Replay Configuration
REPLAY_MODE_DEFAULT=true
RATE_LIMIT_PER_MINUTE=10
